# RewriteEngine On
# RewriteRule ^sitemap\.xml$ sitemap.php [L]
# RewriteCond %{REQUEST_URI} !category/(\d+)
# RewriteRule ^(.*)-(\d+).html$ preview.php?controller=pjLoad&action=pjActionView&id=$2
# RewriteRule category/(\d+)/(\S+).html$ preview.php?controller=pjLoad&action=pjActionIndex&category_id=$1

# # disable TRACK and TRACE http methods. 'RewriteEngine On' is required!
# RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
# RewriteRule .* - [F]

# Options -Indexes
# ServerSignature Off
# <ifModule mod_headers.c>
# 	Header unset X-Powered-By
# </ifModule>

# <IfModule php5_module>
# 	php_value session.cookie_httponly true
# </IfModule>
RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# disable TRACK and TRACE http methods. 'RewriteEngine On' is required!
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
RewriteRule .* - [F]

Options -Indexes
ServerSignature Off
<ifModule mod_headers.c>
	Header unset X-Powered-By
	# Static CSS/JS: always revalidate with the server (cheap 304 when
	# unchanged) so users never keep running an old copy after an upgrade.
	<FilesMatch "\.(css|js)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
</ifModule>

<IfModule php5_module>
	php_value session.cookie_httponly true
</IfModule>